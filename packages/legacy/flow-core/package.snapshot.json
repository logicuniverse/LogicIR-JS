{
  "name": "ff-core",
  "version": "0.4.0",
  "license": "MIT",
  "author": "Zhang Yang",
  "module": "dist/index.js",
  "main": "dist/cjs/index.js",
  "types": "dist/typings/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc  -p tsconfig.json  && tsc -p tsconfig.node.json",
    "prepare": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "watch": "tsc --watch",
    "dev": "tsc --watch  --preserveWatchOutput"
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "engines": {
    "node": ">=12"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^8.2.4",
    "@tsconfig/recommended": "^1.0.2",
    "@types/react": "^18.3.3",
    "tslib": "^2.5.0",
    "typescript": "^5.0.3"
  },
  "dependencies": {
    "@marcbachmann/cel-js": "^7.3.1",
    "@mariozechner/pi-ai": "^0.55.0",
    "ff-runtime-core": "0.4.0"
  }
}
