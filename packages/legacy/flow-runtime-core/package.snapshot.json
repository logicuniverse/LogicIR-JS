{
  "name": "ff-runtime-core",
  "version": "0.4.0",
  "license": "MIT",
  "author": "Zhang Yang",
  "module": "dist/index.js",
  "main": "dist/cjs/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/index.d.ts"
    },
    "./helpers": {
      "import": "./dist/helpers/index.js",
      "require": "./dist/cjs/helpers/index.js",
      "types": "./dist/helpers/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc  -p tsconfig.json  && tsc -p tsconfig.node.json",
    "prepare": "tsc  -p tsconfig.json  && tsc -p tsconfig.node.json",
    "watch": "tsc --watch",
    "dev": "tsc --watch --preserveWatchOutput"
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "engines": {
    "node": ">=12"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^8.2.4",
    "@tsconfig/recommended": "^1.0.2",
    "tslib": "^2.5.0",
    "typescript": "^5.0.3"
  },
  "dependencies": {}
}
